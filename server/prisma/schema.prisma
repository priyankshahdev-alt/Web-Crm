model Location {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  address        String?
  city           String?
  state          String?
  country        String?
  phone          String?
  email          String?
  mapUrl         String?
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)
  isMain         Boolean  @default(false)
